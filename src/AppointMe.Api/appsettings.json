{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RequestTiming": {
    "SlowThresholdMs": 500
  },
  "App": {
    "Name": "AppointMe"
  },
  "Jwt": {
    "Issuer": "AppointMe",
    "Audience": "AppointMe.Client",
    "LifetimeMinutes": 60
  }
}
