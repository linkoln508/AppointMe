@host = https://localhost:7057

### Ping
GET {{host}}/api/ping

### Get all categories
GET {{host}}/api/categories

### Get category by id
GET {{host}}/api/categories/1

### Create category
POST {{host}}/api/categories
Content-Type: application/json

{ "name": "Spa", "slug": "spa" }

### Update category
PUT {{host}}/api/categories/1
Content-Type: application/json

{ "name": "Barber", "slug": "barber" }

### Delete category
DELETE {{host}}/api/categories/999

### Get all businesses
GET {{host}}/api/businesses

### Create business
POST {{host}}/api/businesses
Content-Type: application/json

{ "categoryId": 1, "name": "Classic Barber", "city": "Kharkiv", "address": "Sumska 10" }